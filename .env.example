# Copy to .env.local and fill in. .env* is gitignored — never commit real values.

# ---------------------------------------------------------------------------
# Public — inlined into the client bundle, world-readable. Safe by design.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_PLASMIC_PROJECT_ID=
NEXT_PUBLIC_PLASMIC_PUBLIC_TOKEN=

# The site's own URL. Used to reject cross-origin contact submissions.
# Must match the deployed domain, or every submission is refused.
# localhost is always allowed regardless of this value, so dev is unaffected.
NEXT_PUBLIC_SITE_URL=https://example.com

# ---------------------------------------------------------------------------
# SECRET — server only. NEVER prefix any of these with NEXT_PUBLIC_.
# Anything named NEXT_PUBLIC_* is compiled into the JavaScript sent to every
# visitor. A leaked API key or signing secret there is public permanently.
# ---------------------------------------------------------------------------

# Plasmic CMS write token, used by scripts/import-case-studies.
PLASMIC_CMS_SECRET_TOKEN=

# Resend API key — https://resend.com/api-keys
RESEND_API_KEY=

# Where contact form submissions are delivered. Fixed server-side: the form
# never supplies a recipient, which is what stops it being used as a relay.
CONTACT_TO_EMAIL=you@example.com

# The From address. MUST be on a domain verified in Resend with SPF, DKIM and
# DMARC configured, or mail lands in spam and the domain becomes spoofable.
# Never the submitter's address — that is spoofing and fails DMARC.
CONTACT_FROM_EMAIL=Portfolio Contact <contact@example.com>

# Signs the form's timestamp token so dwell time cannot be forged.
# Generate with:  openssl rand -base64 32
CONTACT_TOKEN_SECRET=

# ---------------------------------------------------------------------------
# Optional — rate limiting. Without these the limiter falls back to in-process
# memory, which resets whenever a serverless instance goes cold. The form still
# works; the limit is simply best-effort. https://console.upstash.com
# ---------------------------------------------------------------------------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
